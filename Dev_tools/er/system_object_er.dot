digraph system_object {  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.28, ranksep=1.0, pad=0.35, bgcolor="white", fontname="DejaVu Sans"];  node [shape=plain, fontname="DejaVu Sans", fontsize=10];  edge [fontname="DejaVu Sans", fontsize=8];  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="22"><B>system_object — metadata DB</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#444444">Solid = physical FK constraint · Dashed = logical FK (seeded, not enforced) · Crow's foot = many · Bar = one</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#666666">catalog</FONT> <FONT COLOR="#1f4e79">■</FONT>  <FONT POINT-SIZE="9" COLOR="#666666">forms/fields</FONT> <FONT COLOR="#2e6b3a">■</FONT>  <FONT POINT-SIZE="9" COLOR="#666666">workflow</FONT> <FONT COLOR="#8a4b08">■</FONT>  <FONT POINT-SIZE="9" COLOR="#666666">relations</FONT> <FONT COLOR="#5b2d82">■</FONT></FONT></TD></TR></TABLE>>;  labelloc="t";  labeljust="l";  "object_icon" [shape=plain label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="0" COLOR="#b8b8b8" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#1f4e79" ALIGN="LEFT" CELLPADDING="4"><FONT COLOR="white" POINT-SIZE="12"><B>object_icon</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10">id</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT COLOR="#666666" POINT-SIZE="9">bigint</FONT> <FONT COLOR="#b8860b" POINT-SIZE="8"><B>PK</B></FONT></TD></TR><TR><TD PORT="path" ALIGN="LEFT" CELLPADDING="3"><FONT POINT-SIZE="10">path</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT COLOR="#666666" POINT-SIZE="9">text</FONT></TD></TR></TABLE>>];
