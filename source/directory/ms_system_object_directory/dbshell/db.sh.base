#!/bin/bash
psql -v ON_ERROR_STOP=1 --username "postgres" --dbname "postgres" <<-EOSQL
  CREATE DATABASE ${DB_NAME};
  CREATE USER ${DB_USER} WITH PASSWORD '${DB_PASSWORD}';
  GRANT ALL PRIVILEGES ON DATABASE ${DB_NAME} TO ${DB_USER};
EOSQL

psql -v ON_ERROR_STOP=1 --username "postgres" --dbname "${DB_NAME}" <<-EOSQL
    GRANT USAGE, CREATE ON SCHEMA public TO ${DB_USER};
EOSQL

psql -v ON_ERROR_STOP=1 --username "${DB_USER}" --dbname "${DB_NAME}" <<-EOSQL
--old
/*
CREATE TABLE public.${DB_TABLENAME} (
  id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name                 text,
  description          text,
  status               smallint default 1,
	prefix               smallint,
	prefix_number        text,
  level                smallint,
  is_group             boolean,
  id_group             bigint,
  ref                  text,
  output_order         smallint,
  icon                 text,
  table_columns        text,
  table_title          text,
  item_title           text,
  item_fields          text,
  on_save_new          text,
  on_save_edit         text,
  on_acceptance        text,
  on_delete            text,
  privileges           text,
  related_documents    text,
  printing_template    text,
  id_transaction       text
	);

COMMENT ON TABLE  ${DB_TABLENAME}                         IS 'Catalog of system objects';
COMMENT ON COLUMN ${DB_TABLENAME}.name                    IS 'Directory name';
COMMENT ON COLUMN ${DB_TABLENAME}.description             IS 'Directory description';
COMMENT ON COLUMN ${DB_TABLENAME}.status                  IS 'Directory status (0 - deleted, 1 - saved)';
COMMENT ON COLUMN ${DB_TABLENAME}.prefix                  IS 'Prefix of DB';
COMMENT ON COLUMN ${DB_TABLENAME}.prefix_number           IS 'Prefix number of system object';
COMMENT ON COLUMN ${DB_TABLENAME}.level                   IS 'Hierarchy level';
COMMENT ON COLUMN ${DB_TABLENAME}.is_group                IS 'Hierarchy group';
COMMENT ON COLUMN ${DB_TABLENAME}.id_group                IS 'Hierarchy group Id';
COMMENT ON COLUMN ${DB_TABLENAME}.ref                     IS 'Endpoint ref';
COMMENT ON COLUMN ${DB_TABLENAME}.output_order            IS 'Output order';
COMMENT ON COLUMN ${DB_TABLENAME}.icon                    IS 'Path to PNG';
COMMENT ON COLUMN ${DB_TABLENAME}.table_columns           IS 'Interface table columns';
COMMENT ON COLUMN ${DB_TABLENAME}.table_title             IS 'Table window title';
COMMENT ON COLUMN ${DB_TABLENAME}.item_title              IS 'Item window title';
COMMENT ON COLUMN ${DB_TABLENAME}.item_fields             IS 'Interface item fields';
COMMENT ON COLUMN ${DB_TABLENAME}.on_save_new             IS 'Save new item';
COMMENT ON COLUMN ${DB_TABLENAME}.on_save_edit            IS 'Save edited item';
COMMENT ON COLUMN ${DB_TABLENAME}.on_acceptance           IS 'Acceptance';
COMMENT ON COLUMN ${DB_TABLENAME}.on_delete               IS 'Delete item';
COMMENT ON COLUMN ${DB_TABLENAME}.privileges              IS 'Privileges';
COMMENT ON COLUMN ${DB_TABLENAME}.related_documents       IS 'Related documents';
COMMENT ON COLUMN ${DB_TABLENAME}.printing_template       IS 'Printable templates';

*/

-- new
  CREATE TABLE public.object_icon (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        path                 text
    );
  COMMENT ON TABLE  object_icon                         IS 'Icon';
  COMMENT ON COLUMN object_icon.id                      IS 'Icon id';
  COMMENT ON COLUMN object_icon.path                    IS 'Icon path';

  CREATE TABLE public.object_link (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        path                 text
    );
  COMMENT ON TABLE  object_link                         IS 'Link';
  COMMENT ON COLUMN object_link.id                      IS 'Link id';
  COMMENT ON COLUMN object_link.path                    IS 'Link url path';

  CREATE TABLE public.object_status (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text
    );
  COMMENT ON TABLE  object_status                       IS 'Status';
  COMMENT ON COLUMN object_status.id                    IS 'Status id';
  COMMENT ON COLUMN object_status.name                  IS 'Name';

  CREATE TABLE public.object_type (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text,
        description          text,
        icon                 bigint
    );
  COMMENT ON TABLE  object_type                         IS 'Object type';
  COMMENT ON COLUMN object_type.id                      IS 'Object type id';
  COMMENT ON COLUMN object_type.name                    IS 'Object type name';
  COMMENT ON COLUMN object_type.description             IS 'Object type description';
  COMMENT ON COLUMN object_type.icon                    IS 'Object type icon';


  CREATE TABLE public.system_object (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text,
        description          text,
        object_type          bigint REFERENCES public.object_type(id),
        object_status        bigint REFERENCES public.object_status(id),
        level                smallint,
        is_system_group      boolean,
        id_system_group      bigint NULL REFERENCES public.system_object(id),
        object_link          bigint REFERENCES public.object_link(id),
        output_order         smallint,
        object_icon          bigint REFERENCES public.object_icon(id),
        prefix_number        text,
        prefix               smallint
    );
  ALTER TABLE public.system_object ADD CONSTRAINT fk_system_object_type   FOREIGN KEY (object_type)     REFERENCES public.object_type(id);
  ALTER TABLE public.system_object ADD CONSTRAINT fk_system_object_status FOREIGN KEY (object_status)   REFERENCES public.object_status(id);
  ALTER TABLE public.system_object ADD CONSTRAINT fk_system_object_group  FOREIGN KEY (id_system_group) REFERENCES public.system_object(id);
  ALTER TABLE public.system_object ADD CONSTRAINT fk_system_object_link   FOREIGN KEY (object_link)     REFERENCES public.object_link(id);
  ALTER TABLE public.system_object ADD CONSTRAINT fk_system_object_icon   FOREIGN KEY (object_icon)     REFERENCES public.object_icon(id);

  COMMENT ON TABLE  system_object                         IS 'Object';
  COMMENT ON COLUMN system_object.id                      IS 'Object id';
  COMMENT ON COLUMN system_object.name                    IS 'Object name';
  COMMENT ON COLUMN system_object.description             IS 'Object description';
  COMMENT ON COLUMN system_object.object_type             IS 'Type identifier';
  COMMENT ON COLUMN system_object.object_status           IS 'Status identifier';
  COMMENT ON COLUMN system_object.level                   IS 'Hierarchy system level';
  COMMENT ON COLUMN system_object.is_system_group         IS 'Hierarchy system group';
  COMMENT ON COLUMN system_object.id_system_group         IS 'Hierarchy system identifier';
  COMMENT ON COLUMN system_object.object_link             IS 'Object link';
  COMMENT ON COLUMN system_object.output_order            IS 'Output order';
  COMMENT ON COLUMN system_object.object_icon             IS 'Object type icon';
  COMMENT ON COLUMN system_object.prefix_number           IS 'Prefix number of system object';
  COMMENT ON COLUMN system_object.prefix                  IS 'Prefix of DB';

  CREATE TABLE public.form_type (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text,
        description          text,
        icon                 bigint
    );
  COMMENT ON TABLE  form_type                           IS 'Form type';
  COMMENT ON COLUMN form_type.id                        IS 'Form type id';
  COMMENT ON COLUMN form_type.name                      IS 'Form type name';
  COMMENT ON COLUMN form_type.description               IS 'Form type description';
  COMMENT ON COLUMN form_type.icon                      IS 'Form type icon';

  CREATE TABLE public.object_fields (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        system_object        bigint,
        name                 text,
        object_type          bigint,
        digits_integer       int,
        digits_fractional    int,
        system_object_field  bigint
    );
  COMMENT ON TABLE  object_fields                         IS 'Fields of object';
  COMMENT ON COLUMN object_fields.id                      IS 'Field identifier';
  COMMENT ON COLUMN object_fields.system_object           IS 'Field of object';
  COMMENT ON COLUMN object_fields.name                    IS 'Field name';
  COMMENT ON COLUMN object_fields.object_type             IS 'Field type';
  COMMENT ON COLUMN object_fields.digits_integer          IS 'Number of digits in the integer part';
  COMMENT ON COLUMN object_fields.digits_fractional       IS 'Number of digits in the fractional part';
  COMMENT ON COLUMN object_fields.system_object_field     IS 'System object field';

  CREATE TABLE public.object_forms (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        system_object        bigint,
        name                 text,
        form_type            bigint
    );
  COMMENT ON TABLE  object_forms                         IS 'Forms of object';
  COMMENT ON COLUMN object_forms.id                      IS 'Form identifier';
  COMMENT ON COLUMN object_forms.system_object           IS 'Form of object';
  COMMENT ON COLUMN object_forms.name                    IS 'Form name';
  COMMENT ON COLUMN object_forms.form_type               IS 'Form type';

  CREATE TABLE public.tab_forms (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text,
        title                text,
        tag                  text,
        object_form          bigint,
        output_order         int,
        visible              boolean
    );
  COMMENT ON TABLE  tab_forms                           IS 'Tab of form';
  COMMENT ON COLUMN tab_forms.id                        IS 'Tab of form identifier';
  COMMENT ON COLUMN tab_forms.name                      IS 'Tab of form name';
  COMMENT ON COLUMN tab_forms.title                     IS 'Tab of form title';
  COMMENT ON COLUMN tab_forms.tag                       IS 'Block layout tag (declension-table); NULL for plain tab';
  COMMENT ON COLUMN tab_forms.object_form               IS 'Form identifier';

  CREATE TABLE public.field_editor_type (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text UNIQUE NOT NULL
    );
  COMMENT ON TABLE  field_editor_type                   IS 'Field editor list';
  COMMENT ON COLUMN field_editor_type.id                IS 'Field editor type identifier';
  COMMENT ON COLUMN field_editor_type.name              IS 'Editor name (manual, dropdown, form)';

  CREATE TABLE public.fields_tab (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        tab_form             bigint,
        object_field         bigint,
        label                text,
        visible              boolean,
        required             boolean,
        editor_type          bigint REFERENCES public.field_editor_type(id),
        editor_ref           bigint REFERENCES public.system_object(id),
        "default"            text
    );
  COMMENT ON TABLE  fields_tab                          IS 'Fields of form tab';
  COMMENT ON COLUMN fields_tab.id                       IS 'Field of form tab identifier';
  COMMENT ON COLUMN fields_tab.tab_form                 IS 'Tab of form identifier';
  COMMENT ON COLUMN fields_tab.object_field             IS 'Field identifier';
  COMMENT ON COLUMN fields_tab.label                    IS 'Label of field';
  COMMENT ON COLUMN fields_tab.visible                  IS 'Field output type (visible ? true:false)';
  COMMENT ON COLUMN fields_tab.required                 IS 'Required field ? true:false';
  COMMENT ON COLUMN fields_tab.editor_type              IS 'Editor type (manual input, dropdown, open selected form); NULL = manual';
  COMMENT ON COLUMN fields_tab.editor_ref               IS 'Reference object for dropdown/form editors (system_object.id); NULL if none';
  COMMENT ON COLUMN fields_tab."default"                IS 'Default value when opening the form';

  CREATE TABLE public.events_type (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text
    );
  COMMENT ON TABLE  events_type                         IS 'Events type';
  COMMENT ON COLUMN events_type.id                      IS 'Events type identifier';
  COMMENT ON COLUMN events_type.name                    IS 'Events type name';

  CREATE TABLE public.method_type (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text,
        method_rest          text
    );
  COMMENT ON TABLE  method_type                         IS 'Method type';
  COMMENT ON COLUMN method_type.id                      IS 'Method type identifier';
  COMMENT ON COLUMN method_type.name                    IS 'Method type name';
  COMMENT ON COLUMN method_type.method_rest             IS 'Method rest(post,put,get)';

  CREATE TABLE public.filter_type (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text UNIQUE NOT NULL
    );
  COMMENT ON TABLE  filter_type                         IS 'Filter field list';
  COMMENT ON COLUMN filter_type.id                      IS 'Filter type identifier';
  COMMENT ON COLUMN filter_type.name                    IS 'Filter field name (id, id_document, ...)';

  CREATE TABLE public.filter_set (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY
    );
  COMMENT ON TABLE  filter_set                          IS 'Filter set header; one row per workflow step needing filters';
  COMMENT ON COLUMN filter_set.id                       IS 'Filter set identifier';

  CREATE TABLE public.filter_set_item (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        filter_set           bigint NOT NULL REFERENCES public.filter_set(id) ON DELETE CASCADE,
        filter_type          bigint NOT NULL REFERENCES public.filter_type(id),
        output_order         int NOT NULL DEFAULT 0,
        UNIQUE (filter_set, filter_type)
    );
  COMMENT ON TABLE  filter_set_item                     IS 'Filters in a set (1..N per workflow step)';
  COMMENT ON COLUMN filter_set_item.id                  IS 'Filter set item identifier';
  COMMENT ON COLUMN filter_set_item.filter_set          IS 'Filter set identifier';
  COMMENT ON COLUMN filter_set_item.filter_type         IS 'Filter type identifier';
  COMMENT ON COLUMN filter_set_item.output_order        IS 'Order of filters in set';

  CREATE TABLE public.value_types (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text,
        value                text
  );
  COMMENT ON TABLE  value_types                         IS 'Type values list';
  COMMENT ON COLUMN value_types.id                      IS 'Value type identifier';
  COMMENT ON COLUMN value_types.name                    IS 'Value type name';
  COMMENT ON COLUMN value_types.value                   IS 'Value type value';

  CREATE TABLE public.map_set (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY
    );
  COMMENT ON TABLE  map_set                               IS 'Map set header; one row per workflow step needing field maps';
  COMMENT ON COLUMN map_set.id                            IS 'Map set identifier';

  CREATE TABLE public.map_set_item (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        map_set              bigint NOT NULL REFERENCES public.map_set(id) ON DELETE CASCADE,
        target_field         text,
        server_field         bigint,
        application_field    bigint,
        value_type           bigint REFERENCES public.value_types(id),
        send_value           text,
        output_order         int NOT NULL DEFAULT 0
    );
  COMMENT ON TABLE  map_set_item                          IS 'Field maps in a set (1..N per workflow step)';
  COMMENT ON COLUMN map_set_item.id                       IS 'Map set item identifier';
  COMMENT ON COLUMN map_set_item.map_set                  IS 'Map set identifier';
  COMMENT ON COLUMN map_set_item.target_field             IS 'Target endpoint field name (text, cross-service; e.g. ddate, status)';
  COMMENT ON COLUMN map_set_item.server_field             IS 'Endpoint field (object_fields.id)';
  COMMENT ON COLUMN map_set_item.application_field        IS 'Application field (object_fields.id)';
  COMMENT ON COLUMN map_set_item.value_type               IS 'Value type';
  COMMENT ON COLUMN map_set_item.send_value               IS 'Send/set value';

  CREATE TABLE public.related_document_set (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY
    );
  COMMENT ON TABLE  related_document_set                  IS 'Related document set header';
  COMMENT ON COLUMN related_document_set.id               IS 'Related document set identifier';

  CREATE TABLE public.related_document_set_item (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        related_document_set bigint NOT NULL REFERENCES public.related_document_set(id) ON DELETE CASCADE,
        document             bigint NOT NULL REFERENCES public.system_object(id),
        output_order         int NOT NULL DEFAULT 0,
        UNIQUE (related_document_set, document)
    );
  COMMENT ON TABLE  related_document_set_item             IS 'Documents in a set (1..N per workflow step)';
  COMMENT ON COLUMN related_document_set_item.id                  IS 'Related document set item identifier';
  COMMENT ON COLUMN related_document_set_item.related_document_set IS 'Related document set identifier';
  COMMENT ON COLUMN related_document_set_item.document            IS 'Document(system_object) identifier';

  CREATE TABLE public.privilege_types (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text,
        value                text
  );
  COMMENT ON TABLE  privilege_types                      IS 'Privilege list';
  COMMENT ON COLUMN privilege_types.id                   IS 'Privilege type identifier';
  COMMENT ON COLUMN privilege_types.name                 IS 'Privilege type name';
  COMMENT ON COLUMN privilege_types.value                IS 'Privilege type value';

  CREATE TABLE public.privilege_set (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY
    );
  COMMENT ON TABLE  privilege_set                         IS 'Privilege set header';
  COMMENT ON COLUMN privilege_set.id                      IS 'Privilege set identifier';

  CREATE TABLE public.privilege_set_item (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        privilege_set        bigint NOT NULL REFERENCES public.privilege_set(id) ON DELETE CASCADE,
        privilege_type       bigint NOT NULL REFERENCES public.privilege_types(id),
        output_order         int NOT NULL DEFAULT 0,
        UNIQUE (privilege_set, privilege_type)
    );
  COMMENT ON TABLE  privilege_set_item                    IS 'Privileges in a set (1..N per workflow step)';
  COMMENT ON COLUMN privilege_set_item.id                 IS 'Privilege set item identifier';
  COMMENT ON COLUMN privilege_set_item.privilege_set      IS 'Privilege set identifier';
  COMMENT ON COLUMN privilege_set_item.privilege_type     IS 'Privilege type identifier';

  CREATE TABLE public.workflow_process (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text,
        object_form          bigint,
        events_type          bigint,
        method_type          bigint,
        step                 int,
        end_point            text,
        filter_set           bigint REFERENCES public.filter_set(id),
        hide_in_preview      boolean NOT NULL DEFAULT FALSE,
        conditions           text NOT NULL DEFAULT '[]',
        set_to_server        bigint REFERENCES public.map_set(id),
        set_to_app           bigint REFERENCES public.map_set(id),
        related_documents    bigint REFERENCES public.related_document_set(id),
        privileges           bigint REFERENCES public.privilege_set(id)
    );
  COMMENT ON TABLE  workflow_process                       IS 'Workflow process';
  COMMENT ON COLUMN workflow_process.id                    IS 'Workflow process identifier';
  COMMENT ON COLUMN workflow_process.object_form           IS 'Form';
  COMMENT ON COLUMN workflow_process.events_type           IS 'Events type';
  COMMENT ON COLUMN workflow_process.method_type           IS 'Method type';
  COMMENT ON COLUMN workflow_process.step                  IS 'Workflow process step';
  COMMENT ON COLUMN workflow_process.end_point             IS 'Target endpoint (document, employee_directory, ...)';
  COMMENT ON COLUMN workflow_process.filter_set            IS 'Filter set reference (filter_set.id); NULL if none';
  COMMENT ON COLUMN workflow_process.hide_in_preview      IS 'Hide step in confirm preview (frontend effects.ts: strictly true hides)';
  COMMENT ON COLUMN workflow_process.conditions            IS 'Step conditions as JSON array string ([{status:1}]); [] if none';
  COMMENT ON COLUMN workflow_process.set_to_server         IS 'Map set for sending to the server (map_set.id); NULL if none';
  COMMENT ON COLUMN workflow_process.set_to_app            IS 'Map set for sending to the application (map_set.id); NULL if none';
  COMMENT ON COLUMN workflow_process.related_documents     IS 'Related document set (related_document_set.id); NULL if none';
  COMMENT ON COLUMN workflow_process.privileges            IS 'Privilege set (privilege_set.id); NULL if none';

  CREATE TABLE public.business_process (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        name                 text,
        percent              int
    );
  COMMENT ON TABLE  business_process                       IS 'Business process';
  COMMENT ON COLUMN business_process.id                    IS 'Business process identifier';
  COMMENT ON COLUMN business_process.name                  IS 'Business process name';
  COMMENT ON COLUMN business_process.percent               IS 'Business process percent';

  CREATE TABLE public.workflow_in_process (
        id                   bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
        workflow_process     bigint,
        business_process     bigint
    );
  COMMENT ON TABLE  workflow_in_process                     IS 'Workflow process in business process';
  COMMENT ON COLUMN workflow_in_process.workflow_process    IS 'Workflow process identifier';
  COMMENT ON COLUMN workflow_in_process.business_process    IS 'Business process identifier';

  insert into object_icon (id, path) values (0, 'dictionary.png');
  insert into object_icon (id, path) values (1, 'document.png');
  insert into object_icon (id, path) values (2, 'report.png');
