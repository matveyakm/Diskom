--SYSTEM_OBJECT_INSERTS_START
-- (entity rows injected here by build-db.sh; everything below runs inside the same psql session)

  CREATE VIEW public.${DB_TABLENAME} AS
  SELECT
    so.id,
    so.name,
    so.description,
    so.object_status AS status,
    so.prefix,
    so.prefix_number,
    so.level,
    so.is_system_group AS is_group,
    so.id_system_group AS id_group,
    ol.path AS ref,
    so.output_order,
    oi.path AS icon,
    (SELECT ot.name FROM public.object_type ot WHERE ot.id = so.object_type) AS object_type_name,
    (SELECT os.name FROM public.object_status os WHERE os.id = so.object_status) AS object_status_name,
    -- list-form title; falls back to object name
    COALESCE(
      (SELECT f.name FROM public.object_forms f
        JOIN public.form_type ft ON ft.id = f.form_type
       WHERE f.system_object = so.id AND ft.name LIKE 'List%'
       ORDER BY f.id LIMIT 1),
      (SELECT f.name FROM public.object_forms f
        WHERE f.system_object = so.id ORDER BY f.id LIMIT 1),
      so.name) AS table_title,
    -- item-form title; empty when no item form exists (ledgers/reports)
    COALESCE(
      (SELECT f.name FROM public.object_forms f
        JOIN public.form_type ft ON ft.id = f.form_type
       WHERE f.system_object = so.id AND ft.name NOT LIKE 'List%'
       ORDER BY f.id LIMIT 1), '') AS item_title,
    -- table_columns from the list (or single) form tabs
    COALESCE(
      (SELECT json_build_object('columns', json_agg(
         json_strip_nulls(json_build_object(
           'field', of.name,
           'label', ftb.label,
           'hidden', NOT ftb.visible,
           'editor', fet.name,
           'editor_ref', (SELECT ol2.path FROM public.system_object so2
                           JOIN public.object_link ol2 ON ol2.id = so2.object_link
                          WHERE so2.id = ftb.editor_ref))
         ) ORDER BY tf.output_order, ftb.id))::text
       FROM public.tab_forms tf
       JOIN public.fields_tab ftb ON ftb.tab_form = tf.id
       JOIN public.object_fields of ON of.id = ftb.object_field
       LEFT JOIN public.field_editor_type fet ON fet.id = ftb.editor_type
       WHERE tf.object_form = COALESCE(
         (SELECT f.id FROM public.object_forms f
           JOIN public.form_type fty ON fty.id = f.form_type
          WHERE f.system_object = so.id AND fty.name LIKE 'List%'
          ORDER BY f.id LIMIT 1),
         (SELECT f.id FROM public.object_forms f
           WHERE f.system_object = so.id ORDER BY f.id LIMIT 1))), '') AS table_columns,
    -- item_fields: flat fields + blocks from the item form
    COALESCE(
      (SELECT json_build_object(
         'fields', COALESCE(json_agg(
           json_strip_nulls(json_build_object(
             'field', of.name,
             'label', ftb.label,
             'hidden', NOT ftb.visible,
             'required', ftb.required,
             'default', ftb."default",
             'editor', fet.name,
             'editor_ref', (SELECT ol2.path FROM public.system_object so2
                             JOIN public.object_link ol2 ON ol2.id = so2.object_link
                            WHERE so2.id = ftb.editor_ref))
           ) ORDER BY tf.output_order, ftb.id)
           FILTER (WHERE of.id IS NOT NULL), '[]'::json),
         'blocks', COALESCE((
           SELECT json_agg(json_build_object(
             'id', tf2.name,
             'title', tf2.title,
             'tag', tf2.tag,
             'fields', (SELECT COALESCE(json_agg(of2.name ORDER BY ftb2.id), '[]'::json)
                        FROM public.fields_tab ftb2
                        JOIN public.object_fields of2 ON of2.id = ftb2.object_field
                        WHERE ftb2.tab_form = tf2.id))
             ORDER BY tf2.output_order)
           FROM public.tab_forms tf2
           WHERE tf2.object_form = itf.id), '[]'::json))
       FROM public.object_forms itf
       LEFT JOIN public.tab_forms tf ON tf.object_form = itf.id
       LEFT JOIN public.fields_tab ftb ON ftb.tab_form = tf.id
       LEFT JOIN public.object_fields of ON of.id = ftb.object_field
       LEFT JOIN public.field_editor_type fet ON fet.id = ftb.editor_type
       WHERE itf.system_object = so.id
         AND itf.id NOT IN
           (SELECT f.id FROM public.object_forms f
             JOIN public.form_type fty ON fty.id = f.form_type
            WHERE f.system_object = so.id AND fty.name LIKE 'List%')
       GROUP BY itf.id)::text, '') AS item_fields,
    -- workflow actions, one subquery per event
    (SELECT json_build_object('action', 'onSaveNew', 'processing', COALESCE(json_agg(s.step ORDER BY (s.step->>'step')::int), '[]'::json))::text
     FROM (SELECT json_build_object(
             'step', wp.step,
             'method', (SELECT mt.name FROM public.method_type mt WHERE mt.id = wp.method_type),
             'end_point', wp.end_point,
             'filter', (SELECT fty.name FROM public.filter_set_item fsi
                         JOIN public.filter_type fty ON fty.id = fsi.filter_type
                        WHERE fsi.filter_set = wp.filter_set ORDER BY fsi.output_order LIMIT 1),
             'filters', COALESCE((SELECT json_agg(fty.name ORDER BY fsi.output_order)
                                  FROM public.filter_set_item fsi
                                  JOIN public.filter_type fty ON fty.id = fsi.filter_type
                                  WHERE fsi.filter_set = wp.filter_set), '[]'::json),
             'hide_in_preview', wp.hide_in_preview,
             'map', (COALESCE((SELECT json_agg(json_build_object(COALESCE(mi.target_field, ''), mi.send_value) ORDER BY mi.output_order)::jsonb
                              FROM public.map_set_item mi WHERE mi.map_set = wp.set_to_server), '[]'::jsonb)
                        || COALESCE((SELECT json_agg(json_build_object(COALESCE(mi.target_field, ''), mi.send_value) ORDER BY mi.output_order)::jsonb
                                     FROM public.map_set_item mi WHERE mi.map_set = wp.set_to_app), '[]'::jsonb))::text,
             'conditions', wp.conditions::json) AS step
           FROM public.workflow_process wp
           JOIN public.events_type et ON et.id = wp.events_type
           WHERE wp.object_form IN (SELECT id FROM public.object_forms WHERE system_object = so.id)
             AND et.name = 'onSaveNew'
           ORDER BY wp.step) s) AS on_save_new,
    (SELECT json_build_object('action', 'onSaveEdit', 'processing', COALESCE(json_agg(s.step ORDER BY (s.step->>'step')::int), '[]'::json))::text
     FROM (SELECT json_build_object(
             'step', wp.step,
             'method', (SELECT mt.name FROM public.method_type mt WHERE mt.id = wp.method_type),
             'end_point', wp.end_point,
             'filter', (SELECT fty.name FROM public.filter_set_item fsi
                         JOIN public.filter_type fty ON fty.id = fsi.filter_type
                        WHERE fsi.filter_set = wp.filter_set ORDER BY fsi.output_order LIMIT 1),
             'filters', COALESCE((SELECT json_agg(fty.name ORDER BY fsi.output_order)
                                  FROM public.filter_set_item fsi
                                  JOIN public.filter_type fty ON fty.id = fsi.filter_type
                                  WHERE fsi.filter_set = wp.filter_set), '[]'::json),
             'hide_in_preview', wp.hide_in_preview,
             'map', (COALESCE((SELECT json_agg(json_build_object(COALESCE(mi.target_field, ''), mi.send_value) ORDER BY mi.output_order)::jsonb
                              FROM public.map_set_item mi WHERE mi.map_set = wp.set_to_server), '[]'::jsonb)
                        || COALESCE((SELECT json_agg(json_build_object(COALESCE(mi.target_field, ''), mi.send_value) ORDER BY mi.output_order)::jsonb
                                     FROM public.map_set_item mi WHERE mi.map_set = wp.set_to_app), '[]'::jsonb))::text,
             'conditions', wp.conditions::json) AS step
           FROM public.workflow_process wp
           JOIN public.events_type et ON et.id = wp.events_type
           WHERE wp.object_form IN (SELECT id FROM public.object_forms WHERE system_object = so.id)
             AND et.name = 'onSaveEdit'
           ORDER BY wp.step) s) AS on_save_edit,
    (SELECT json_build_object('action', 'onAcceptance', 'processing', COALESCE(json_agg(s.step ORDER BY (s.step->>'step')::int), '[]'::json))::text
     FROM (SELECT json_build_object(
             'step', wp.step,
             'method', (SELECT mt.name FROM public.method_type mt WHERE mt.id = wp.method_type),
             'end_point', wp.end_point,
             'filter', (SELECT fty.name FROM public.filter_set_item fsi
                         JOIN public.filter_type fty ON fty.id = fsi.filter_type
                        WHERE fsi.filter_set = wp.filter_set ORDER BY fsi.output_order LIMIT 1),
             'filters', COALESCE((SELECT json_agg(fty.name ORDER BY fsi.output_order)
                                  FROM public.filter_set_item fsi
                                  JOIN public.filter_type fty ON fty.id = fsi.filter_type
                                  WHERE fsi.filter_set = wp.filter_set), '[]'::json),
             'hide_in_preview', wp.hide_in_preview,
             'map', (COALESCE((SELECT json_agg(json_build_object(COALESCE(mi.target_field, ''), mi.send_value) ORDER BY mi.output_order)::jsonb
                              FROM public.map_set_item mi WHERE mi.map_set = wp.set_to_server), '[]'::jsonb)
                        || COALESCE((SELECT json_agg(json_build_object(COALESCE(mi.target_field, ''), mi.send_value) ORDER BY mi.output_order)::jsonb
                                     FROM public.map_set_item mi WHERE mi.map_set = wp.set_to_app), '[]'::jsonb))::text,
             'conditions', wp.conditions::json) AS step
           FROM public.workflow_process wp
           JOIN public.events_type et ON et.id = wp.events_type
           WHERE wp.object_form IN (SELECT id FROM public.object_forms WHERE system_object = so.id)
             AND et.name = 'onAcceptance'
           ORDER BY wp.step) s) AS on_acceptance,
    (SELECT json_build_object('action', 'onDelete', 'processing', COALESCE(json_agg(s.step ORDER BY (s.step->>'step')::int), '[]'::json))::text
     FROM (SELECT json_build_object(
             'step', wp.step,
             'method', (SELECT mt.name FROM public.method_type mt WHERE mt.id = wp.method_type),
             'end_point', wp.end_point,
             'filter', (SELECT fty.name FROM public.filter_set_item fsi
                         JOIN public.filter_type fty ON fty.id = fsi.filter_type
                        WHERE fsi.filter_set = wp.filter_set ORDER BY fsi.output_order LIMIT 1),
             'filters', COALESCE((SELECT json_agg(fty.name ORDER BY fsi.output_order)
                                  FROM public.filter_set_item fsi
                                  JOIN public.filter_type fty ON fty.id = fsi.filter_type
                                  WHERE fsi.filter_set = wp.filter_set), '[]'::json),
             'hide_in_preview', wp.hide_in_preview,
             'map', (COALESCE((SELECT json_agg(json_build_object(COALESCE(mi.target_field, ''), mi.send_value) ORDER BY mi.output_order)::jsonb
                              FROM public.map_set_item mi WHERE mi.map_set = wp.set_to_server), '[]'::jsonb)
                        || COALESCE((SELECT json_agg(json_build_object(COALESCE(mi.target_field, ''), mi.send_value) ORDER BY mi.output_order)::jsonb
                                     FROM public.map_set_item mi WHERE mi.map_set = wp.set_to_app), '[]'::jsonb))::text,
             'conditions', wp.conditions::json) AS step
           FROM public.workflow_process wp
           JOIN public.events_type et ON et.id = wp.events_type
           WHERE wp.object_form IN (SELECT id FROM public.object_forms WHERE system_object = so.id)
             AND et.name = 'onDelete'
           ORDER BY wp.step) s) AS on_delete,
    -- privileges: union of step sets across object forms; all-false when no sets
    (SELECT json_build_object('privileges', json_agg(
       json_build_object(pt.name,
         CASE WHEN EXISTS (SELECT 1 FROM public.privilege_set_item psi
                           JOIN public.workflow_process wpx ON wpx.privileges = psi.privilege_set
                           WHERE wpx.object_form IN (SELECT id FROM public.object_forms WHERE system_object = so.id)
                             AND psi.privilege_type = pt.id)
              THEN 'true' ELSE 'false' END)
       ORDER BY pt.id))::text
     FROM public.privilege_types pt) AS privileges,
    -- related documents: flat id list across step sets
    (SELECT json_build_object('related_documents', COALESCE(json_agg(
       json_build_object('system_object_id', rdi.document) ORDER BY rdi.output_order),
       '[]'::json))::text
     FROM public.related_document_set_item rdi
     JOIN public.workflow_process wpx ON wpx.related_documents = rdi.related_document_set
     WHERE wpx.object_form IN (SELECT id FROM public.object_forms WHERE system_object = so.id)) AS related_documents,
    -- business processes linked via workflow steps of this object
    (SELECT COALESCE(json_agg(
       json_build_object('id', bp.id, 'name', bp.name, 'percent', bp.percent)
       ORDER BY bp.id), '[]'::json)::text
     FROM public.business_process bp
     WHERE EXISTS (SELECT 1 FROM public.workflow_in_process wip
                   JOIN public.workflow_process wpx ON wpx.id = wip.workflow_process
                   WHERE wip.business_process = bp.id
                     AND wpx.object_form IN (SELECT id FROM public.object_forms WHERE system_object = so.id))
    ) AS business_processes,
    '' AS printing_template,
    NULL::text AS id_transaction
  FROM public.system_object so
  LEFT JOIN public.object_link ol ON ol.id = so.object_link
  LEFT JOIN public.object_icon oi ON oi.id = so.object_icon;
  COMMENT ON VIEW public.${DB_TABLENAME} IS 'Legacy catalog read view over normalized tables; NOT UPDATABLE';

  -- Tables stay tiny (26 rows) forever, i.e. below the autoanalyze
  -- threshold (50 + 10%). Without stats the planner assumes 1000 rows
  -- and picks a catastrophic shape for the view (15s+ per scan).
  ANALYZE public.system_object;
  ANALYZE public.object_icon;
  ANALYZE public.object_link;
  ANALYZE public.object_status;
  ANALYZE public.object_type;
  ANALYZE public.form_type;
  ANALYZE public.object_fields;
  ANALYZE public.object_forms;
  ANALYZE public.tab_forms;
  ANALYZE public.fields_tab;
  ANALYZE public.field_editor_type;
  ANALYZE public.events_type;
  ANALYZE public.method_type;
  ANALYZE public.filter_type;
  ANALYZE public.filter_set;
  ANALYZE public.filter_set_item;
  ANALYZE public.value_types;
  ANALYZE public.map_set;
  ANALYZE public.map_set_item;
  ANALYZE public.related_document_set;
  ANALYZE public.related_document_set_item;
  ANALYZE public.privilege_types;
  ANALYZE public.privilege_set;
  ANALYZE public.privilege_set_item;
  ANALYZE public.workflow_process;
  ANALYZE public.business_process;
  ANALYZE public.workflow_in_process;

  commit;
EOSQL
