# Порядок микросервисов в docker-compose.yaml (строго как сейчас).
# Строка = путь под source/ (без префикса source/).
# Новый микросервис: добавь фрагмент source/<type>/ms_<name>/system_description/compose_part.yaml
# и строку сюда в нужное место. Volumes для него допиши руками в docker-compose.base.yaml.
# Если файл удалён — build-compose.sh перейдёт на автообнаружение (порядок изменится, но всё соберётся).
document/ms_document
directory/ms_employee_directory
directory/ms_department_directory
directory/ms_regulations_clauses_directory
directory/ms_organization_directory
directory/ms_counterparty_directory
directory/ms_job_title_directory
document/ms_appointment_document
document/ms_dismissal_document
document/ms_acceptance_document
ledger/ms_employee_data_ledger
ledger/ms_staff_placement_ledger
document/ms_create_department_document
ledger/ms_department_data_ledger
document/ms_create_job_title_document
ledger/ms_job_title_data_ledger
document/ms_create_counterparty_document
document/ms_create_organization_document
document/ms_create_regulations_clauses_document
ledger/ms_organization_data_ledger
report/ms_job_report
directory/ms_system_object_directory
directory/ms_disciplinary_measures
directory/ms_reasons_for_the_dcs_disagreement
